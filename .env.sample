# Discord bot token (https://discord.com/developers/applications -> Bot -> Token)
discord_token=
# Channel id(s) the bot posts to, comma-separated for several
# (enable Developer Mode -> right-click channel -> Copy ID)
channel=

# Set to 1/true/yes for testnet; anything else (including 0, false or empty) is mainnet
testnet=1

# COOP main AA address. If omitted, a testnet default is used when testnet=1.
# coop_aa=

# Token registry AA used to resolve the COOP symbol/decimals.
TOKEN_REGISTRY_AA_ADDRESS=O6H6ZIFI57X3PLTYHOCVYPP5A553CYFQ
# Fallback decimals if the token isn't in the registry yet (COOP uses 9).
# coop_decimals=9

# Web app the notifications link back to.
# coop_url=https://coop.obyte.org
# coop_name=Obyte COOP
